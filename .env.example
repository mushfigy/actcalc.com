# SECURE DEFAULT: does not publish until all operator and service data is set.
ACTCALC_PUBLIC=false
ACTCALC_ALLOW_LOCAL_DEV=false
ACTCALC_OPERATOR_NAME=
ACTCALC_PRIVACY_EMAIL=
ACTCALC_CONTACT_SECRET=
ACTCALC_ADMIN_TOKEN=
ACTCALC_PREVIEW_TOKEN=
ACTCALC_ALLOWED_HOSTS=actcalc.com,www.actcalc.com
ACTCALC_DB_PATH=/data/actcalc.sqlite3
ACTCALC_SMTP_HOST=
ACTCALC_SMTP_PORT=587
ACTCALC_SMTP_MODE=starttls
ACTCALC_SMTP_USER=
ACTCALC_SMTP_PASSWORD=
ACTCALC_SMTP_SENDER=
ACTCALC_SMTP_RECIPIENT=

# These flags must reflect real completed checks; never set just to force a release.
ACTCALC_LEGAL_REVIEW_CONFIRMED=false
ACTCALC_SMTP_DELIVERY_VERIFIED=false
ACTCALC_BACKUP_RESTORE_VERIFIED=false
ACTCALC_LIVE_DEVICE_VERIFIED=false
